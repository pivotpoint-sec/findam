# --- Database ---------------------------------------------------------------
# PostgreSQL 14+ with the PostGIS and pg_trgm extensions.
DATABASE_URL=postgres://findam:findam@localhost:5432/findam

# --- Site -------------------------------------------------------------------
# Public URL of the site, used in bot messages and share links.
SITE_URL=http://localhost:3000

# Admin panel login (HTTP basic auth on /admin). Change these.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Where uploaded photos are stored on disk. Swap src/lib/storage.ts for S3,
# Cloudinary or similar before running more than one server.
UPLOAD_DIR=./uploads

# --- WhatsApp Cloud API (Meta) ------------------------------------------------
# Leave WHATSAPP_TOKEN empty in development: the bot then logs replies to the
# console instead of sending, and you can test it in /admin/bot.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The bot's public number, shown on the site as "Send Hi on WhatsApp", e.g. +2349012345678
WHATSAPP_DISPLAY_NUMBER=
# Any random string; enter the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=change-me
# App secret from Meta, used to check webhook signatures.
WHATSAPP_APP_SECRET=
# Approved message template for the weekly "still there?" check. It needs two
# quick-reply buttons: "Yes, same place" and "We moved". See README.
WHATSAPP_PING_TEMPLATE=weekly_check
WHATSAPP_TEMPLATE_LANG=en

# --- Optional: travel time for top results --------------------------------------
# Self-hosted or public OSRM server. Empty = straight-line distance only.
OSRM_URL=
